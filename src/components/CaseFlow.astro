---
interface Props {
  title: string;
  steps: { title: string; detail: string }[];
  caption: string;
}
const { title, steps, caption } = Astro.props;
---

<figure class="case-flow">
  <figcaption>{title}</figcaption>
  <ol>
    {steps.map((step) => (
      <li>
        <strong>{step.title}</strong>
        <span>{step.detail}</span>
      </li>
    ))}
  </ol>
  <p>{caption}</p>
</figure>

<style>
  .case-flow {
    margin: 28px 0;
    padding: 20px;
    border-radius: 12px;
    background: var(--surface);
  }
  figcaption {
    font-size: 14px;
    font-weight: 650;
    margin-bottom: 16px;
  }
  ol {
    display: flex;
    list-style: none;
    gap: 24px;
    padding: 0;
    margin: 0;
  }
  li {
    position: relative;
    flex: 1;
    min-width: 0;
    padding: 12px;
    background: var(--surface-muted);
    border-radius: 8px;
  }
  li + li::before {
    content: "→";
    position: absolute;
    left: -20px;
    top: 12px;
    color: var(--text-muted);
  }
  strong,
  span {
    display: block;
  }
  strong {
    font-size: 13px;
    line-height: 1.4;
  }
  span {
    font-size: 12px;
    line-height: 1.5;
    margin-top: 6px;
    color: var(--text-muted);
  }
  .case-flow p {
    font-size: 12px;
    line-height: 1.6;
    color: var(--text-muted);
    margin: 16px 0 0;
  }
  @media (max-width: 600px) {
    ol {
      flex-direction: column;
    }
    li + li::before {
      content: "↓";
      left: 16px;
      top: -25px;
    }
  }
</style>
