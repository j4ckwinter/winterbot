---
import Layout from "../layouts/Layout.astro";
import {
  Home,
  Station,
  PostOffice,
  ProjectStory,
} from "../components/town/PlaceContent";
import { projects } from "../components/town/projects";
import "../styles/portfolio.css";
---

<Layout
  title="Jack Winter — Projects & Experience"
  description="Jack Winter, senior software engineer in London. Selected projects, technical experience, and contact details."
>
  <div class="plain-portfolio">
    <header class="portfolio-header">
      <a href="/">← Explore the town</a>
      <a href="mailto:jackwinter.10@gmail.com">Get in touch ↗</a>
    </header>
    <main id="main">
      <div class="portfolio-intro">
        <h1>
          Jack Winter<span>.</span>
        </h1>
        <p>Senior software engineer · London</p>
      </div>
      <nav class="portfolio-nav" aria-label="Portfolio sections">
        <a href="#projects">Projects</a>
        <a href="#about">About & skills</a>
        <a href="#experience">Experience</a>
        <a href="#contact">Contact</a>
      </nav>
      <section id="projects" aria-labelledby="projects-title">
        <h2 id="projects-title">Projects</h2>
        <div class="portfolio-projects">
          {projects.map((project) => (
            <article class="portfolio-project" id={project.slug}>
              <h3>{project.name}</h3>
              <p>{project.description}</p>
              <ProjectStory project={project} />
              <ul class="portfolio-tags" aria-label="Technologies">
                {project.tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
              <div class="portfolio-project-links">
                <a
                  href={project.github}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  View source ↗
                </a>
                {project.live && (
                  <a
                    href={project.live}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {project.action} ↗
                  </a>
                )}
              </div>
            </article>
          ))}
        </div>
      </section>
      <section id="about" aria-labelledby="about-title">
        <h2 id="about-title">About & skills</h2>
        <div class="place-content">
          <Home />
        </div>
      </section>
      <section id="experience" aria-labelledby="experience-title">
        <h2 id="experience-title">Experience</h2>
        <div class="place-content">
          <Station />
        </div>
      </section>
      <section id="contact" aria-labelledby="contact-title">
        <h2 id="contact-title">Contact</h2>
        <div class="place-content">
          <PostOffice />
        </div>
      </section>
    </main>
    <footer class="portfolio-footer">
      <a href="#main">Back to top ↑</a>
      <a href="/">Explore Winter Town ↗</a>
    </footer>
  </div>
</Layout>
