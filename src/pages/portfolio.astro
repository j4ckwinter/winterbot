---
import { profile } from "../components/town/profile";
import Layout from "../layouts/Layout.astro";
import {
  About,
  Skills,
  Station,
  PostOffice,
  ProjectStory,
  ProjectSummary,
} from "../components/town/PlaceContent";
import { projects } from "../components/town/projects";
import "../styles/portfolio.css";
---

<Layout
  title="Jack Winter — Projects & Experience"
  description={profile.description}
>
  <div class="plain-portfolio">
    <header class="portfolio-header">
      <a href="/">← Explore the town</a>
      <a href={`mailto:${profile.email}`}>Get in touch ↗</a>
    </header>
    <main id="main">
      <div class="portfolio-intro">
        <img
          src="/profile.jpeg"
          width="319"
          height="319"
          alt="Pixel-art portrait of Jack Winter"
          class="portfolio-portrait"
        />
        <div>
          <h1>
            Jack Winter<span>.</span>
          </h1>
          <p>
            {profile.role} · {profile.location}
          </p>
          <div class="portfolio-intro-actions">
            <a href={profile.cvUrl} download>
              Download CV ↓
            </a>
            <a href={`mailto:${profile.email}`}>Email Jack ↗</a>
          </div>
        </div>
      </div>
      <nav class="portfolio-nav" aria-label="Portfolio sections">
        <a href="#about">About</a>
        <a href="#projects">Projects</a>
        <a href="#experience">Experience</a>
        <a href="#skills">Skills</a>
        <a href="#contact">Contact</a>
      </nav>
      <section id="about" aria-labelledby="about-title">
        <h2 id="about-title">About</h2>
        <div class="place-content">
          <About />
        </div>
      </section>
      <section id="projects" aria-labelledby="projects-title">
        <h2 id="projects-title">Projects</h2>
        <div class="portfolio-projects">
          {projects.map((project) => (
            <article class="portfolio-project" id={project.slug}>
              <h3>{project.name}</h3>
              <ProjectSummary project={project} />
              <ProjectStory project={project} />
              <ul class="portfolio-tags" aria-label="Technologies">
                {project.tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
              <div class="portfolio-project-links">
                <a
                  href={project.github}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  View source ↗
                </a>
                {project.live && (
                  <a
                    href={project.live}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {project.action} ↗
                  </a>
                )}
              </div>
            </article>
          ))}
        </div>
      </section>
      <section id="experience" aria-labelledby="experience-title">
        <h2 id="experience-title">Experience</h2>
        <div class="place-content">
          <Station />
        </div>
      </section>
      <section id="skills" aria-labelledby="skills-title">
        <h2 id="skills-title">Skills & education</h2>
        <div class="place-content">
          <Skills />
        </div>
      </section>
      <section id="contact" aria-labelledby="contact-title">
        <h2 id="contact-title">Contact</h2>
        <div class="place-content">
          <PostOffice />
        </div>
      </section>
    </main>
    <footer class="portfolio-footer">
      <a href="#main">Back to top ↑</a>
      <a href="/">Explore Winter Town ↗</a>
    </footer>
  </div>
</Layout>
